# Copy to .env.iam; never commit real credentials.
NB_MONGO_URI=mongodb://127.0.0.1:27017
NB_MONGO_DB=nanobanana
NB_IMAGE_STORAGE=local
# Resolve relative paths from banana_backend; use an absolute persistent path in deployment.
NB_IMAGE_ROOT=./data/images
# For private Alibaba Cloud OSS, switch NB_IMAGE_STORAGE to oss and fill these.
# cn-hangzhou and oss-cn-hangzhou are both accepted; choose the actual bucket region.
NB_OSS_BUCKET=
NB_OSS_REGION=
# Optional region endpoint; HTTPS only. Leave empty to use the public regional endpoint.
NB_OSS_ENDPOINT=
NB_OSS_PREFIX=nanobanana/images
# access_key: server-side RAM credentials below; default: official credential chain (ECS/OIDC).
NB_OSS_AUTH_MODE=access_key
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Optional static STS token; replace all three credentials before expiry and restart.
ALIBABA_CLOUD_SECURITY_TOKEN=
NB_MIGRATION_DIR=./data/migrations
# Legacy IAM MySQL settings: used only by historical migration.
NB_DB_HOST=127.0.0.1
NB_DB_PORT=3306
NB_DB_USER=
NB_DB_PASSWORD=
NB_DB_NAME=nanobanana
IAM_URL=http://127.0.0.1:18080
OIDC_ISSUER=http://localhost:8180/realms/nexus
OIDC_JWKS=http://localhost:8180/realms/nexus/protocol/openid-connect/certs
OIDC_CLIENT_SECRET=
WORKBENCH_ORIGIN=http://localhost:5174
# Optional exact additional origins, comma-separated (e.g. http://192.168.1.178:5274).
WORKBENCH_ORIGINS=
# LAN dev: /realms/nexus sends browser SSO through the frontend's scoped IdP proxy.
# The actual OIDC_ISSUER/JWKS and IAM token validation stay unchanged.
OIDC_BROWSER_PATH=
# Generate a 32-byte random base64 key. Rotation requires re-encrypting active sessions and login states; keep the old key during migration.
IAM_SESSION_KEY=
# Exact HTTPS image hostnames returned by your configured providers, comma-separated.
NB_IMAGE_HOST_ALLOWLIST=

# 147AI Gemini native image generation/editing; keep this key server-side.
AI147_BASE_URL=https://nn.147ai.com
AI147_API_KEY=

# 火山方舟 Seedance 2.5. Add ARK_API_KEY to the backend .env or .env.iam.
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628

# Model management MySQL. Set to enable the runtime connection pool.
# NB_MYSQL_URI=mysql://model_app:password@127.0.0.1:3306/nanobanana_models

# Model administration: set the allowed Nexus_IAM tenant ID.
# NB_MODEL_ADMIN_TENANT_ID=
# Inject a canonical Base64-encoded 32-byte key from a deployment Secret.
# NB_MODEL_KEY_BASE64=
# NB_MODEL_KEY_VERSION=1
